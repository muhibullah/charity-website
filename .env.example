# Copy this file to .env and fill in the values. Never put .env on GitHub.

# On your laptop: true. On the live server: false.
DEBUG=true
# A long random string. Make a new one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
SITE_NAME=Giving Circle

# Laptop: localhost,127.0.0.1   Live: yourname.pythonanywhere.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Live only: https://yourname.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com

# Leave unset to use the SQLite file (fine on PythonAnywhere's free plan).
# DATABASE_URL=postgres://user:password@host:5432/dbname
